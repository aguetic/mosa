---
interface Props { title: string; image?: string; }
const { title, image } = Astro.props;
---
<section class:list={["page-intro container", { "has-art": image }]}>
  <h1>{title}</h1>
  <div class="intro-copy"><slot /></div>
  {image && <img class="intro-art" src={`/images/${image}.webp`} alt="" aria-hidden="true" width="300" height="360" />}
</section>
