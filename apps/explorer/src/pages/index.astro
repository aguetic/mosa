---
import RestitutionCaseSummaryCard from "../components/RestitutionCaseSummaryCard.astro";
import Layout from "../layouts/Layout.astro";
import { formatSourceLabel } from "../lib/labels";
import { formatLiteralValue } from "../lib/presentation";
import {
  ENTITY_TYPES,
  type EntitySummary,
  type EntityType,
  isEntityType,
  SEARCH_PAGE_SIZE,
  searchEntities,
} from "../lib/queries";
import { type RestitutionCaseSummary, searchRestitutionCases } from "../lib/restitution";

const searchText = Astro.url.searchParams.get("q")?.trim() ?? "";
const requestedType = Astro.url.searchParams.get("type") ?? "";
const entityType = isEntityType(requestedType) ? requestedType : null;
const requestedPage = Number(Astro.url.searchParams.get("page") ?? "1");
const page = Number.isInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;

let entities: EntitySummary[] = [];
let totalCount = 0;
let restitutionCases: RestitutionCaseSummary[] = [];
let loadFailed = false;

const entityHref = (entity: EntitySummary): string =>
  entity.entityType === "event" ? `/events/${entity.id}` : `/entities/${entity.id}`;

const GROUP_LABELS: Record<EntityType, string> = {
  item: "Items",
  agent: "Agents",
  place: "Places",
  source: "Sources",
  event: "Events",
};

try {
  const [searchResult, caseResults] = await Promise.all([
    searchEntities(searchText, entityType, page),
    entityType === null && page === 1
      ? searchRestitutionCases(searchText)
      : Promise.resolve([]),
  ]);
  entities = searchResult.entities;
  totalCount = searchResult.totalCount;
  restitutionCases = caseResults;
} catch (error) {
  loadFailed = true;
  console.error("Unable to load entities", error);
}

const groups = ENTITY_TYPES.map((type) => ({
  type,
  label: GROUP_LABELS[type],
  entities: entities.filter((entity) => entity.entityType === type),
})).filter((group) => group.entities.length > 0);

const totalPages = Math.max(1, Math.ceil(totalCount / SEARCH_PAGE_SIZE));
const pageHref = (target: number): string => {
  const params = new URLSearchParams();
  if (searchText) params.set("q", searchText);
  if (entityType) params.set("type", entityType);
  if (target > 1) params.set("page", String(target));
  const queryString = params.toString();
  return queryString ? `/?${queryString}` : "/";
};

const resultCount = totalCount + (page === 1 ? restitutionCases.length : 0);
---

<Layout title="Search">
  <p class="eyebrow">Model inspection</p>
  <h1>Explore the current model</h1>
  <p class="lede">
    Search the current synthetic entities, provenance events and restitution cases, then follow
    their claims, attribution, relationships, and evidence. This interface does not modify the
    database.
  </p>

  <form class="search-form" method="get" action="/">
    <label>
      Name, identifier or source reference
      <input name="q" type="search" value={searchText} placeholder="MPE 32571" />
    </label>
    <label>
      Entity type
      <select name="type">
        <option value="">All types</option>
        {ENTITY_TYPES.map((type) => <option value={type} selected={type === entityType}>{type}</option>)}
      </select>
    </label>
    <button type="submit">Search</button>
  </form>

  {
    loadFailed ? (
      <div class="notice">
        The local database could not be read. Start Supabase with <code>pnpm run db:start</code>,
        load the fixtures with <code>pnpm run db:fixtures</code>, and reload this page.
      </div>
    ) : (
      <>
        <p class="muted">
          Showing {resultCount} {resultCount === 1 ? "result" : "results"}
          {totalPages > 1 ? ` (page ${page} of ${totalPages})` : ""}.
        </p>

        {restitutionCases.length > 0 && (
          <>
            <h2 id="cases">Restitution cases <span class="muted">({restitutionCases.length})</span></h2>
            <section class="claims" aria-label="Restitution case results">
              {restitutionCases.map((restitutionCase) => (
                <RestitutionCaseSummaryCard restitutionCase={restitutionCase} />
              ))}
            </section>
          </>
        )}

        {entities.length === 0 && restitutionCases.length === 0 ? (
          <div class="empty">
            No records match this search. Check the spelling, try fewer or shorter words, or
            clear the entity type filter.
          </div>
        ) : (
          groups.map((group) => (
            <>
              <h2>{group.label} <span class="muted">({group.entities.length})</span></h2>
              <section class="results" aria-label={`${group.label} results`}>
                {group.entities.map((entity) => (
                  <article class="result-card">
                    <div class="result-card__top">
                      <h3>
                        <a href={entityHref(entity)}>
                          {entity.entityType === "source"
                            ? formatSourceLabel(entity.displayLabel)
                            : entity.displayLabel}
                        </a>
                      </h3>
                      <div class="badges">
                        {entity.subtypeKind && <span class="badge">{entity.subtypeKind}</span>}
                      </div>
                    </div>
                    {entity.entityType === "event" && (
                      <p class="claim-meta">
                        {formatLiteralValue(entity.eventDate) ?? "Date not recorded"}
                      </p>
                    )}
                    {entity.identifiers.length > 0 && (
                      <ul class="identifier-list">
                        {entity.identifiers.map((identifier) => (
                          <li><code>{identifier.namespace}:{identifier.value}</code></li>
                        ))}
                      </ul>
                    )}
                  </article>
                ))}
              </section>
            </>
          ))
        )}

        {totalPages > 1 && (
          <nav class="pagination" aria-label="Search result pages">
            {page > 1 && <a href={pageHref(page - 1)}>← Previous</a>}
            <span class="muted">Page {page} of {totalPages}</span>
            {page < totalPages && <a href={pageHref(page + 1)}>Next →</a>}
          </nav>
        )}
      </>
    )
  }
</Layout>
