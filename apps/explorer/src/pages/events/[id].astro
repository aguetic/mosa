---
import ProvenanceEventCard from "../../components/ProvenanceEventCard.astro";
import Layout from "../../layouts/Layout.astro";
import { getProvenanceEvent, type ProvenanceEventDetail } from "../../lib/provenance";
import { provenanceStatementValue } from "../../lib/provenance-presentation";
import { isUuid } from "../../lib/values";

const id = Astro.params.id ?? "";
let event: ProvenanceEventDetail | null = null;
let loadFailed = false;

if (isUuid(id)) {
  try {
    event = await getProvenanceEvent(id);
  } catch (error) {
    loadFailed = true;
    console.error(`Unable to load provenance event ${id}`, error);
  }
}

if (!event && !loadFailed) {
  Astro.response.status = 404;
}
---

<Layout title={event?.workingLabel ?? "Provenance event not found"}>
  <p class="breadcrumb"><a href="/">← Entity search</a></p>

  {
    loadFailed ? (
      <div class="notice">The local database could not be read. Check the Astro server console for details.</div>
    ) : !event ? (
      <>
        <h1>Provenance event not found</h1>
        <p class="lede">No Phase 2 event exists with this identifier.</p>
      </>
    ) : (
      <>
        <p class="eyebrow">Provenance event</p>
        <h1>{event.workingLabel}</h1>
        <dl class="metadata panel">
          <div><dt>Event ID</dt><dd><code>{event.id}</code></dd></div>
          <div><dt>Operational kind</dt><dd>{event.eventKind}</dd></div>
          {event.notes && <div><dt>Notes</dt><dd>{event.notes}</dd></div>}
        </dl>

        <h2>Attributed event statements</h2>
        <ProvenanceEventCard event={event} />

        {
          event.incomingStatements.length > 0 && (
            <>
              <h2>Claims pointing to this event</h2>
              <section class="claims">
                {event.incomingStatements.map((statement) => (
                  <article class="claim-card">
                    <p class="claim-expression">
                      <a href={`/events/${statement.subjectId}`}>{statement.subjectLabel}</a>{" "}
                      <span class="predicate">{statement.predicate}</span>{" "}
                      <span>{provenanceStatementValue(statement)}</span>
                    </p>
                    <p class="claim-meta">
                      Asserted by {statement.assertedByLabel ?? "unrecorded agent"} ·{" "}
                      {statement.evidence.length} evidence {statement.evidence.length === 1 ? "link" : "links"}
                    </p>
                  </article>
                ))}
              </section>
            </>
          )
        }
      </>
    )
  }
</Layout>
