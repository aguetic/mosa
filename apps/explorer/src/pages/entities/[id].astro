---
import ClaimCard from "../../components/ClaimCard.astro";
import ProvenanceEventSummaryCard from "../../components/ProvenanceEventSummaryCard.astro";
import RestitutionCaseSummaryCard from "../../components/RestitutionCaseSummaryCard.astro";
import Layout from "../../layouts/Layout.astro";
import { formatSourceLabel } from "../../lib/labels";
import { itemPageView } from "../../lib/object-presentation";
import { buildItemSummary } from "../../lib/object-summary";
import { formatDate, isHttpReference } from "../../lib/presentation";
import { getProvenanceEventsForItem, type ProvenanceEvent } from "../../lib/provenance";
import { partitionProvenanceEvents } from "../../lib/provenance-presentation";
import {
  type ClaimDetail,
  type EntityDetail,
  getClaimsForEntity,
  getEntity,
} from "../../lib/queries";
import {
  getRestitutionCasesForItem,
  getRestitutionDocumentsForItem,
  type RestitutionCaseSummary,
  type RestitutionItemDocument,
} from "../../lib/restitution";
import { isUuid } from "../../lib/values";

const id = Astro.params.id ?? "";
let entity: EntityDetail | null = null;
let claims: ClaimDetail[] = [];
let provenanceEvents: ProvenanceEvent[] = [];
let restitutionCases: RestitutionCaseSummary[] = [];
let restitutionDocuments: RestitutionItemDocument[] = [];
let loadFailed = false;

if (isUuid(id)) {
  try {
    [entity, claims, provenanceEvents, restitutionCases, restitutionDocuments] =
      await Promise.all([
        getEntity(id),
        getClaimsForEntity(id),
        getProvenanceEventsForItem(id),
        getRestitutionCasesForItem(id),
        getRestitutionDocumentsForItem(id),
      ]);
  } catch (error) {
    loadFailed = true;
    console.error(`Unable to load entity ${id}`, error);
  }
}

if (!entity && !loadFailed) {
  Astro.response.status = 404;
}

const isItem = entity?.entityType === "item";
const itemSummary =
  isItem && entity
    ? buildItemSummary({
        itemId: entity.id,
        claims,
        identifiers: entity.identifiers,
        provenanceEvents,
        restitutionCases,
        restitutionDocuments,
      })
    : null;
const itemView = itemSummary ? itemPageView(itemSummary) : null;

const provenanceGroups = partitionProvenanceEvents(provenanceEvents);

const outgoingClaims = entity
  ? claims.filter((claim) => claim.subjectId === entity?.id)
  : [];
const incomingClaims = entity
  ? claims.filter((claim) => claim.objectEntityId === entity?.id)
  : [];
const retrievedAt = entity ? formatDate(entity.retrievedAt) : null;

const nonItemOutgoing = isItem ? [] : outgoingClaims;
const nonItemIncoming = isItem ? [] : incomingClaims;
---

<Layout title={entity?.displayLabel ?? "Entity not found"}>
  <p class="breadcrumb"><a href="/">← Entity search</a></p>

  {
    loadFailed ? (
      <div class="notice">The local database could not be read. Check the Astro server console for details.</div>
    ) : !entity ? (
      <>
        <h1>Entity not found</h1>
        <p class="lede">No Phase 1 entity exists with this identifier.</p>
      </>
    ) : (
      <>
        <p class="eyebrow">{entity.entityType}</p>
        <h1>{entity.displayLabel}</h1>
        <div class="badges">
          <span class="badge">{entity.entityType}</span>
          {entity.subtypeKind && <span class="badge">{entity.subtypeKind}</span>}
        </div>

        {
          itemView && (
            <>
              <h2>{itemView.origin.title}</h2>
              <p class="lede">{itemView.origin.description}</p>
              {itemView.origin.rows.length === 0 ? (
                <div class="empty">{itemView.origin.emptyText}</div>
              ) : (
                <dl class="metadata panel">
                  {itemView.origin.rows.map((row) => (
                    <div>
                      <dt>{row.label}</dt>
                      <dd>
                        {row.href ? <a href={row.href}>{row.value}</a> : row.value}

                        {row.qualifications.map((qualification) => (
                          <p class="claim-meta">
                            <strong>Source qualification:</strong> {qualification}
                          </p>
                        ))}

                        <p class="claim-meta">
                          <a href={`/claims/${row.claim.id}`}>View claim</a>
                          {" · "}
                          Asserted by{" "}
                          {row.claim.assertedByAgentId ? (
                            <a href={`/entities/${row.claim.assertedByAgentId}`}>
                              {row.claim.assertedByLabel ?? row.claim.assertedByAgentId}
                            </a>
                          ) : (
                            "unrecorded agent"
                          )}
                        </p>

                        {row.claim.evidence.length > 0 && (
                          <ul class="evidence-list">
                            {row.claim.evidence.map((evidence) => (
                              <li>
                                <strong>
                                  {evidence.relationship === "qualifies"
                                    ? "Source qualification"
                                    : evidence.relationship}
                                </strong>
                                {" · "}
                                <a href={`/entities/${evidence.sourceId}`}>
                                  {formatSourceLabel(evidence.sourceLabel)}
                                </a>
                                {evidence.locator ? ` · ${evidence.locator}` : ""}
                                {evidence.excerpt ? ` · “${evidence.excerpt}”` : ""}
                              </li>
                            ))}
                          </ul>
                        )}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}

              <h2>{itemView.currentState.title}</h2>
              <p class="lede">{itemView.currentState.description}</p>
              {itemView.currentState.rows.length === 0 ? (
                <div class="empty">{itemView.currentState.emptyText}</div>
              ) : (
                <dl class="metadata panel">
                  {itemView.currentState.rows.map((row) => (
                    <div>
                      <dt>{row.label}</dt>
                      <dd>
                        {row.href ? <a href={row.href}>{row.value}</a> : row.value}

                        {row.qualifications.map((qualification) => (
                          <p class="claim-meta">
                            <strong>Source qualification:</strong> {qualification}
                          </p>
                        ))}

                        <p class="claim-meta">
                          <a href={`/claims/${row.claim.id}`}>View claim</a>
                          {" · "}
                          Asserted by{" "}
                          {row.claim.assertedByAgentId ? (
                            <a href={`/entities/${row.claim.assertedByAgentId}`}>
                              {row.claim.assertedByLabel ?? row.claim.assertedByAgentId}
                            </a>
                          ) : (
                            "unrecorded agent"
                          )}
                        </p>

                        {row.claim.evidence.length > 0 && (
                          <ul class="evidence-list">
                            {row.claim.evidence.map((evidence) => (
                              <li>
                                <strong>
                                  {evidence.relationship === "qualifies"
                                    ? "Source qualification"
                                    : evidence.relationship}
                                </strong>
                                {" · "}
                                <a href={`/entities/${evidence.sourceId}`}>
                                  {formatSourceLabel(evidence.sourceLabel)}
                                </a>
                                {evidence.locator ? ` · ${evidence.locator}` : ""}
                                {evidence.excerpt ? ` · “${evidence.excerpt}”` : ""}
                              </li>
                            ))}
                          </ul>
                        )}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}

              <h2>{itemView.documents.title}</h2>
              <p class="lede">{itemView.documents.description}</p>
              {itemView.documents.rows.length === 0 ? (
                <div class="empty">{itemView.documents.emptyText}</div>
              ) : (
                <div class="panel">
                  <ul class="identifier-list">
                    {itemView.documents.rows.map((document) => (
                      <li>
                        <a href={document.sourceHref}>{formatSourceLabel(document.sourceLabel)}</a>
                        {document.associations.length > 0 && (
                          <>
                            {" · "}
                            {document.associations.join("; ")}
                          </>
                        )}
                        {document.caseLinks.map((caseLink) => (
                          <>
                            {" · "}
                            <a href={caseLink.href}>{caseLink.label}</a>
                          </>
                        ))}
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <h2>Provenance events</h2>
              <p class="lede">
                Displayed by reported date. This does not assert a complete or continuous chronology.
              </p>
              {provenanceEvents.length === 0 ? (
                <div class="empty">{itemView.provenanceEmptyText}</div>
              ) : (
                <>
                  {provenanceGroups.dated.length > 0 && (
                    <section class="claims" aria-label="Provenance events">
                      {provenanceGroups.dated.map((event) => (
                        <ProvenanceEventSummaryCard event={event} />
                      ))}
                    </section>
                  )}
                  {provenanceGroups.undated.length > 0 && (
                    <>
                      <h3>Events without a recorded date</h3>
                      <p class="lede">Their position in the sequence is not recorded.</p>
                      <section class="claims" aria-label="Undated provenance events">
                        {provenanceGroups.undated.map((event) => (
                          <ProvenanceEventSummaryCard event={event} />
                        ))}
                      </section>
                    </>
                  )}
                </>
              )}

              {restitutionCases.length > 0 && (
                <>
                  <h2>Restitution cases</h2>
                  <section class="claims" aria-label="Restitution cases">
                    {restitutionCases.map((restitutionCase) => (
                      <RestitutionCaseSummaryCard restitutionCase={restitutionCase} />
                    ))}
                  </section>
                </>
              )}

              <h2>Claims about this entity</h2>
              <section class="claims" aria-label="Other outgoing claims">
                {itemView.remainingOutgoingClaims.length === 0 ? (
                  <div class="empty">No additional outgoing claims.</div>
                ) : (
                  itemView.remainingOutgoingClaims.map((claim) => <ClaimCard claim={claim} />)
                )}
              </section>

              <h2>Claims pointing to this entity</h2>
              <section class="claims" aria-label="Incoming claims">
                {itemView.remainingIncomingClaims.length === 0 ? (
                  <div class="empty">No additional incoming claims.</div>
                ) : (
                  itemView.remainingIncomingClaims.map((claim) => <ClaimCard claim={claim} />)
                )}
              </section>
            </>
          )
        }

        {
          !isItem && (
            <>
              <h2>Claims about this entity</h2>
              <section class="claims" aria-label="Outgoing claims">
                {nonItemOutgoing.length === 0 ? (
                  <div class="empty">No outgoing claims.</div>
                ) : (
                  nonItemOutgoing.map((claim) => <ClaimCard claim={claim} />)
                )}
              </section>

              <h2>Claims pointing to this entity</h2>
              <section class="claims" aria-label="Incoming claims">
                {nonItemIncoming.length === 0 ? (
                  <div class="empty">No incoming claims.</div>
                ) : (
                  nonItemIncoming.map((claim) => <ClaimCard claim={claim} />)
                )}
              </section>
            </>
          )
        }

        <h2>Record details</h2>
        <dl class="metadata panel">
          <div>
            <dt>Entity ID</dt>
            <dd><code>{entity.id}</code></dd>
          </div>
          <div>
            <dt>Subtype</dt>
            <dd>{entity.subtypeKind ?? "Not recorded"}</dd>
          </div>
          <div>
            <dt>Display label basis</dt>
            <dd>
              {entity.displayLabelBasis}
              {entity.displayLabelClaimId && (
                <>
                  {" · "}
                  <a href={`/claims/${entity.displayLabelClaimId}`}>view claim</a>
                </>
              )}
            </dd>
          </div>
          {
            entity.reference && (
              <div>
                <dt>Source reference</dt>
                <dd>
                  {isHttpReference(entity.reference) ? (
                    <a href={entity.reference} rel="noreferrer">{entity.reference}</a>
                  ) : (
                    <span>{entity.reference}</span>
                  )}
                </dd>
              </div>
            )
          }
          {retrievedAt && <div><dt>Retrieved</dt><dd>{retrievedAt}</dd></div>}
        </dl>

        <h2>External identifiers</h2>
        {
          entity.identifiers.length === 0 ? (
            <div class="empty">No external identifiers are recorded.</div>
          ) : (
            <div class="panel">
              <ul class="identifier-list">
                {entity.identifiers.map((identifier) => (
                  <li>
                    <code>{identifier.namespace}:{identifier.value}</code>
                    {identifier.sourceId && identifier.sourceLabel && (
                      <> · source <a href={`/entities/${identifier.sourceId}`}>{formatSourceLabel(identifier.sourceLabel)}</a></>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </>
    )
  }
</Layout>
