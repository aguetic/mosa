---
import { formatSourceLabel, predicateLabel } from "../lib/labels";
import type { ProvenanceEvent, ProvenanceStatement } from "../lib/provenance";
import {
  generateProvenanceEventTitle,
  provenanceStatementValue,
} from "../lib/provenance-presentation";

interface Props {
  event: ProvenanceEvent;
}

const { event } = Astro.props;
const title = generateProvenanceEventTitle(event);

const FIELD_ORDER = [
  "moved_item",
  "held_item",
  "transferred_item",
  "moved_from",
  "moved_to",
  "moved_via",
  "occurred_at",
  "carried_out_by",
  "holding_agent",
  "transferred_from",
  "transferred_to",
  "occurred_during",
  "described_as",
] as const;

const FIELD_LABELS: Record<string, string> = {
  moved_item: "Moved item",
  held_item: "Held item",
  transferred_item: "Transferred item",
  moved_from: "From",
  moved_to: "To",
  moved_via: "Via",
  carried_out_by: "Carried out by",
  holding_agent: "Holding agent",
  transferred_from: "Transferred from",
  transferred_to: "Transferred to",
  occurred_during: "Date",
  described_as: "Source wording",
  occurred_at: "Event location",
};

const statements = [...event.statements].sort((left, right) => {
  const leftIndex = FIELD_ORDER.indexOf(left.predicate as (typeof FIELD_ORDER)[number]);
  const rightIndex = FIELD_ORDER.indexOf(right.predicate as (typeof FIELD_ORDER)[number]);
  const normalizedLeft = leftIndex === -1 ? FIELD_ORDER.length : leftIndex;
  const normalizedRight = rightIndex === -1 ? FIELD_ORDER.length : rightIndex;
  return normalizedLeft - normalizedRight || left.predicate.localeCompare(right.predicate);
});

function entityHref(id: string, entityType: string | null): string {
  return entityType === "event" ? `/events/${id}` : `/entities/${id}`;
}

function fieldLabel(statement: ProvenanceStatement): string {
  return FIELD_LABELS[statement.predicate] ?? predicateLabel(statement.predicate);
}

function attributionKey(statement: ProvenanceStatement): string {
  return JSON.stringify([
    statement.assertedByAgentId,
    statement.status,
    statement.evidence.map((evidence) => [
      evidence.relationship,
      evidence.sourceId,
      evidence.locator,
      evidence.excerpt,
    ]),
  ]);
}

const sharedAttribution =
  statements.length > 1 &&
  statements.every((statement) => attributionKey(statement) === attributionKey(statements[0]))
    ? statements[0]
    : null;
---

<article class="claim-card">
  <div class="claim-card__top">
    <h3><a href={`/events/${event.id}`}>{title}</a></h3>
    <div class="badges">
      <span class="badge">{event.eventKind}</span>
    </div>
  </div>

  {
    sharedAttribution && (
      <>
        <p class="claim-meta">
          All statements status {sharedAttribution.status} · asserted by{" "}
          {sharedAttribution.assertedByAgentId ? (
            <a href={`/entities/${sharedAttribution.assertedByAgentId}`}>
              {sharedAttribution.assertedByLabel ?? sharedAttribution.assertedByAgentId}
            </a>
          ) : (
            "unrecorded agent"
          )}
        </p>
        {sharedAttribution.evidence.length > 0 && (
          <ul class="evidence-list">
            {sharedAttribution.evidence.map((evidence) => (
              <li>
                <strong>{evidence.relationship}</strong> ·{" "}
                <a href={`/entities/${evidence.sourceId}`}>{formatSourceLabel(evidence.sourceLabel)}</a>
                {evidence.locator ? ` · ${evidence.locator}` : ""}
                {evidence.excerpt ? ` · “${evidence.excerpt}”` : ""}
              </li>
            ))}
          </ul>
        )}
      </>
    )
  }

  {
    statements.length === 0 ? (
      <div class="empty">No statements recorded.</div>
    ) : (
      <dl class="metadata panel">
        {statements.map((statement) => (
          <div>
            <dt>{fieldLabel(statement)}</dt>
            <dd>
              {statement.valueKind === "entity" && statement.objectEntityId ? (
                <a href={entityHref(statement.objectEntityId, statement.objectEntityType)}>
                  {provenanceStatementValue(statement)}
                </a>
              ) : (
                <span class="literal">{provenanceStatementValue(statement)}</span>
              )}
              {statement.literalLanguage && (
                <span class="muted"> ({statement.literalLanguage})</span>
              )}
              {sharedAttribution ? (
                <p class="claim-meta">
                  <a href={`/claims/${statement.id}`} aria-label={`View ${fieldLabel(statement)} claim`}>
                    View claim
                  </a>
                </p>
              ) : (
                <>
                  <p class="claim-meta">
                    <a href={`/claims/${statement.id}`} aria-label={`View ${fieldLabel(statement)} claim`}>
                      View claim
                    </a>{" "}
                    · status {statement.status} · Asserted by{" "}
                    {statement.assertedByAgentId ? (
                      <a href={`/entities/${statement.assertedByAgentId}`}>
                        {statement.assertedByLabel ?? statement.assertedByAgentId}
                      </a>
                    ) : (
                      "unrecorded agent"
                    )}
                  </p>
                  {statement.evidence.length > 0 && (
                    <ul class="evidence-list">
                      {statement.evidence.map((evidence) => (
                        <li>
                          <strong>{evidence.relationship}</strong> ·{" "}
                          <a href={`/entities/${evidence.sourceId}`}>
                            {formatSourceLabel(evidence.sourceLabel)}
                          </a>
                          {evidence.locator ? ` · ${evidence.locator}` : ""}
                          {evidence.excerpt ? ` · “${evidence.excerpt}”` : ""}
                        </li>
                      ))}
                    </ul>
                  )}
                </>
              )}
            </dd>
          </div>
        ))}
      </dl>
    )
  }
</article>
