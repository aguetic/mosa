---
import { formatSourceLabel, predicateLabel, predicatePhrase } from "../lib/labels";
import { literalLabel } from "../lib/presentation";
import type { ClaimDetail } from "../lib/queries";

interface Props {
  claim: ClaimDetail;
}

const { claim } = Astro.props;

function entityHref(id: string, entityType: string | null): string {
  return entityType === "event" ? `/events/${id}` : `/entities/${id}`;
}

const objectLabel =
  claim.valueKind === "entity" ? (claim.objectEntityLabel ?? claim.objectEntityId) : literalLabel(claim);
const isTautology = claim.valueKind === "literal" && objectLabel === claim.subjectLabel;
---

<article class="claim-card">
  <div class="claim-card__top">
    <h3><a href={`/claims/${claim.id}`}>{predicateLabel(claim.predicate)}</a></h3>
    <div class="badges">
      <span class="badge">value: {claim.valueKind}</span>
      <span class="badge">status: {claim.status}</span>
    </div>
  </div>

  <p class="claim-expression">
    {
      isTautology ? (
        <span class="literal">{objectLabel}</span>
      ) : (
        <>
          <a href={entityHref(claim.subjectId, claim.subjectType)}>{claim.subjectLabel}</a>
          <span class="predicate">{predicatePhrase(claim.predicate)}</span>
          {claim.valueKind === "entity" && claim.objectEntityId ? (
            <a href={entityHref(claim.objectEntityId, claim.objectEntityType)}>{objectLabel}</a>
          ) : (
            <span class="literal">{objectLabel}</span>
          )}
        </>
      )
    }
    {claim.literalLanguage && <span class="muted"> ({claim.literalLanguage})</span>}
  </p>

  <p class="claim-meta">
    Asserted by {
      claim.assertedByAgentId ? (
        <a href={`/entities/${claim.assertedByAgentId}`}>
          {claim.assertedByLabel ?? claim.assertedByAgentId}
        </a>
      ) : (
        <span>unrecorded agent</span>
      )
    } · {claim.evidence.length} evidence {claim.evidence.length === 1 ? "link" : "links"}
  </p>

  {
    claim.evidence.length > 0 && (
      <ul class="evidence-list">
        {claim.evidence.map((evidence) => (
          <li>
            <strong>{evidence.relationship}</strong> ·{" "}
            <a href={`/entities/${evidence.sourceId}`}>{formatSourceLabel(evidence.sourceLabel)}</a>
            {evidence.locator ? ` · ${evidence.locator}` : ""}
          </li>
        ))}
      </ul>
    )
  }
</article>
